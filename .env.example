# ---- Netlify (set these in Site configuration > Environment variables) ----
# Netlify DB sets NETLIFY_DATABASE_URL for you.
# First admin account, created automatically on the first request when there are no users yet.
# Change the password after signing in, then you can delete these two.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ---- Local / self-hosted server ----
PORT=3001
# Folder for the embedded Postgres database (ignored when NETLIFY_DATABASE_URL or DATABASE_URL is set)
DATA_DIR=./data/pg
# Set to true when served over HTTPS
SECURE_COOKIES=false
# Set to true (or a hop count like 1) when running behind a reverse proxy
TRUST_PROXY=
