# ---- Database: run `neon deploy` (or `neon env pull`) to write these to .env.local ----
# DATABASE_URL=postgresql://...-pooler...neon.tech/neondb?sslmode=require       (pooled: the app)
# DATABASE_URL_UNPOOLED=postgresql://...neon.tech/neondb?sslmode=require        (direct: npm run migrate)
# On Netlify, set DATABASE_URL in Project configuration > Environment variables.

# First admin account, created automatically on the first request when there are no users yet.
# Change the password after signing in, then you can delete these two.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ---- Local / self-hosted server ----
PORT=3001
# Folder for the embedded Postgres database (used only when DATABASE_URL is not set)
DATA_DIR=./data/pg
# Set to true when served over HTTPS
SECURE_COOKIES=false
# Set to true (or a hop count like 1) when running behind a reverse proxy
TRUST_PROXY=
