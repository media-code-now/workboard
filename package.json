{
  "name": "workboard",
  "version": "1.0.0",
  "private": true,
  "description": "Company projects and tasks dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node scripts/seed.js",
    "user": "node scripts/user.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@netlify/neon": "^0.1.2",
    "express": "^5.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
